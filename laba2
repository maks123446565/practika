text = input('Введите текст: ')
words = text.split()
count = {}
for word in words:
    if word in count:
        count[word] += 1
    else:
        count[word] = 1
max_word = words[0]
for word in count:
    if count[word] > count[max_word]:
        max_word = word
print(max_word)

