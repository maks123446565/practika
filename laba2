def make_reader_card():
    numbers = input('Введите номера прочитанных книг через пробел: ')
    numbers = numbers.split()
    card = set()
    for number in numbers:
        card.add(int(number))
    return card
def print_book(data):
    for number in data:
        print(number, '—', books[number])
